# Git attributes for consistent line endings and file handling

# Set default behavior for all files
* text=auto eol=lf

# Explicitly declare text files
*.php text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.conf text eol=lf
*.htaccess text eol=lf

# Declare files that should always have LF line endings on checkout
Dockerfile text eol=lf
docker-entrypoint.sh text eol=lf
*.sh text eol=lf

# Denote all files that are truly binary and should not be modified
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary

# Ensure shell scripts are executable
*.sh text eol=lf
docker-entrypoint.sh text eol=lf
