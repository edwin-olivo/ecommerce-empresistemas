<div class="container mx-auto px-4 py-8">
    <!-- Breadcrumbs -->

    <div class="flex flex-col lg:flex-row gap-8">
        <!-- Sidebar de filtros -->
        <aside class="lg:w-1/4">
        </aside>

        <!-- Contenido principal -->
        <main class="lg:w-3/4">
            <!-- Header de resultados -->
            <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center mb-6">
                <div>
                    <h1 class="text-2xl font-bold text-gray-900 mb-2">Productos</h1>
                    {if isset($pagination)}
                        <p class="text-gray-600">
                            Mostrando {count($products)} de {$pagination['total_records']} productos
                        </p>
                    {/if}
                </div>

                <!-- Vista de grid/lista -->
                <div class="flex items-center space-x-2 mt-4 sm:mt-0">
                    <button
                        id="grid-view"
                        class="p-2 border border-gray-300 rounded-md hover:bg-gray-50 cursor-pointer active"
                        data-view="grid">
                        <i class="fas fa-th-large"></i>
                    </button>
                    <button
                        id="list-view"
                        class="p-2 border border-gray-300 rounded-md hover:bg-gray-50 cursor-pointer"
                        data-view="list">
                        <i class="fas fa-list"></i>
                    </button>
                </div>
            </div>

            <!-- Grid de productos -->
            <div id="products-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
                {if isset($products) && !empty($products)}
                    {foreach $products as $product}
                        {include 'product-card.latte', product => $product}
                    {/foreach}
                {else}
                    <!-- Sin productos -->
                    <div class="col-span-full text-center py-12">
                        <div class="text-gray-400 mb-4">
                            <i class="fas fa-box-open text-6xl"></i>
                        </div>
                        <h3 class="text-lg font-medium text-gray-900 mb-2">No se encontraron productos</h3>
                        <p class="text-gray-500 mb-4">Intenta ajustar tus filtros de búsqueda</p>
                        <a
                            href="{Router::url('/productos')}"
                            class="inline-flex items-center px-4 py-2 bg-primary-600 text-white rounded-md hover:bg-primary-700">
                            Ver todos los productos
                        </a>
                    </div>
                {/if}
            </div>

            <!-- Paginación -->
            {if isset($pagination) && $pagination['total_pages'] > 1}
                <div class="mt-8 flex justify-center">
                    <nav class="flex items-center space-x-2">
                        {var $currentPage = $pagination['current_page']}
                        {var $totalPages = $pagination['total_pages']}
                        {var $currentUrl = $_SERVER['REQUEST_URI']}
                        {var $baseUrl = strtok($currentUrl, '?')}
                        {var $currentParams = $_GET}

                        <!-- Página anterior -->
                        {if $currentPage > 1}
                            {var $currentParams['page'] = $currentPage - 1}
                            {var $prevUrl = $baseUrl . '?' . http_build_query($currentParams)}
                            <a href="{$prevUrl}" class="px-3 py-2 border border-gray-300 rounded-md hover:bg-gray-200">
                                <i class="fas fa-chevron-left"></i>
                            </a>
                        {/if}

                        <!-- Números de página -->
                        {for $i = max(1, $currentPage - 2); $i <= min($totalPages, $currentPage + 2); $i++}
                            {var $currentParams['page'] = $i}
                            {var $pageUrl = $baseUrl . '?' . http_build_query($currentParams)}
                            <a
                                href="{$pageUrl}"
                                class="px-3 py-2 border rounded-md {$i == $currentPage ? 'bg-primary-600 text-white border-primary-600 hover:bg-primary-700 transition-colors' : 'border-gray-300 hover:bg-gray-200'}">
                                {$i}
                            </a>
                        {/for}

                        <!-- Página siguiente -->
                        {if $currentPage < $totalPages}
                            {var $currentParams['page'] = $currentPage + 1}
                            {var $nextUrl = $baseUrl . '?' . http_build_query($currentParams)}
                            <a href="{$nextUrl}" class="px-3 py-2 border border-gray-300 rounded-md hover:bg-gray-200">
                                <i class="fas fa-chevron-right"></i>
                            </a>
                        {/if}
                    </nav>
                </div>
            {/if}
        </main>
    </div>
</div>

<style>
    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>